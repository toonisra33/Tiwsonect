rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection test document: allowed publicly to test connectivity
    match /test/connection {
      allow read: if true;
    }

    // Users Collection: Public profile reading, strictly owner-only writing
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && request.auth.uid == userId
        && incoming().id == userId
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().avatar is string && incoming().avatar.size() <= 1000;
      allow update: if isSignedIn() 
        && request.auth.uid == userId
        && incoming().id == existing().id;
      allow delete: if false;
    }

    // Posts Collection: Public reading of feed posts, strictly authenticated author/interactions for writes
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().content is string && incoming().content.size() <= 3000
        && incoming().timestamp is number;
      allow update: if isSignedIn() && (
        // Author updates content/media
        (existing().userId == request.auth.uid && incoming().userId == existing().userId && incoming().timestamp == existing().timestamp) ||
        // Interactions: Like, Save, Comment
        (incoming().userId == existing().userId && incoming().timestamp == existing().timestamp && incoming().content == existing().content && incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'savedBy', 'comments']))
      );
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Messages Collection: Private 1:1 messaging between participants only
    match /messages/{messageId} {
      allow read: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn() 
        && incoming().senderId == request.auth.uid
        && incoming().receiverId is string && incoming().receiverId.size() <= 128
        && incoming().text is string && incoming().text.size() <= 2000
        && incoming().timestamp is number;
      allow update: if isSignedIn() && existing().receiverId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isSignedIn() && existing().senderId == request.auth.uid;
    }

    // Notifications Collection: Strictly private to notification recipient
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Live Sessions Collection: Publicly discoverable live sessions
    match /liveSessions/{sessionId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().title is string && incoming().title.size() <= 200;
      allow update: if isSignedIn() && (
        (existing().userId == request.auth.uid) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['viewerCount']))
      );
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
